# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/devops_monitoring

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_strong_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list (production only)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── AI Provider (Phase 2+) ───────────────────────────────────────────────────
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o
# AI_MAX_TOKENS=2048
# AI_TEMPERATURE=0.2

# ─── Notification Providers (Phase 2+) ───────────────────────────────────────
# SLACK_WEBHOOK_URL=
# PAGERDUTY_API_KEY=
